        mise_a_jour_complete
      );
      /** Description du projet (localité concernée; lieu-dit; etc.)
       */
      DESCRIPTION : MANDATORY TEXT*100;
      /** Date de délivrance
       */
      DATE : MANDATORY FORMAT INTERLIS.XMLDate "2000-1-1" .. "2099-1-1";
      /** Date de mutation du PCN ou fond de plan qui servait comme base à l'élaboration du PAG (p.ex yyyy-mm-jj)
       */
      DATE_MUTATION_FOND_DE_PLAN : MANDATORY FORMAT INTERLIS.XMLDate "2004-1-1" .. "2018-8-28";
      /** Nom du bureau d'études
       */
      NOM_BUR_ET : MANDATORY TEXT*50;
    END Gestion;

  END GESTION;

  /** Contient l'Inventaire des biotopes à l’intérieur du périmètre (art 17 loi modifiée du 19 janvier 2004)
   */
  TOPIC ARTIKEL17 =

    /** Inventaire des biotopes à l’intérieur du périmètre (art 17 loi modifiée du 19 janvier 2004)
     */
    CLASS BIOTOPE_LIGNE =
      /** code du type de biotope tel que defini dans Kurzanleitung zur Erfassung der nach Art. 17 des
       * luxemburgischen Naturschutzgesetzes
       * geschützten Biotope
       * in den Siedlungs- und Gewerbegebieten
       */
      CATEGORIE (FINAL) : (
        /** mur en pierres sèches
         */
        Tm,
        /** Feldwege
         */
        uW,
        /** "Waldmantel"
         */
        Wma,
        /** haie-"Feldhecke"
         */
        FHe,
        /** haie-"Schnitthecke"
         */
        SHe,
        /** groupes arbres
         */
        BG,
        /** rangée d'arbres
         */
        BR,
        /** Éboulis médio-européens calcaires
         */
        FFH8160,
        /** Pentes rocheuses calcaires avec végétation chasmophytique
         */
        FFH8210,
        /** Éboulis médio-européens siliceux
         */
        FFH8150,
        /** Pentes rocheuses siliceuses avec végétation chasmophytique
         */
        FFH8220
      );
      /** géométrie du biotope
       */
      GEOMETRIE : MANDATORY POLYLINE WITH (STRAIGHTS) VERTEX PAG.LUREF;
    END BIOTOPE_LIGNE;

    /** Inventaire des biotopes à l’intérieur du périmètre (art 17 loi modifiée du 19 janvier 2004)
     */
    CLASS BIOTOPE_POINT =
      /** code du type de biotope tel que defini dans Kurzanleitung zur Erfassung der nach Art. 17 des
       * luxemburgischen Naturschutzgesetzes
       * geschützten Biotope
       * in den Siedlungs- und Gewerbegebieten
       */
      CATEGORIE (FINAL) : (
        /** sources
         */
        BK05,
        /** Pentes rocheuses siliceuses avec végétation chasmophytique
         */
        FFH8220,
        /** Sources pétrifiantes avec formation de travertins (Cratoneurion)
         */
        FFH7220,
        /** Pentes rocheuses calcaires avec végétation chasmophytique
         */
        FFH8210,
        /** arbres isolés
         */
        EB,
        /** Éboulis médio-européens siliceux
         */
        FFH8150,
        /** Éboulis médio-européens calcaires
         */
        FFH8160,
        /** groupes arbres
         */
        BG
      );
      /** géométrie du biotope
       */
      GEOMETRIE : MANDATORY PAG.LUREF;
    END BIOTOPE_POINT;

    /** Inventaire des biotopes à l’intérieur du périmètre (art 17 loi modifiée du 19 janvier 2004)
     */
    CLASS BIOTOPE_POLY =
      /** code du type de biotope tel que défini dans Kurzanleitung zur Erfassung der nach Art. 17 des
       * luxemburgischen Naturschutzgesetzes
       * geschützten Biotope
       * in den Siedlungs- und Gewerbegebieten
       */
      CATEGORIE (FINAL) : (
        /** Végétation flottante de renoncules des rivières submontagnardes et planitiaires
         */
        FFH3260,
        /** Tourbières de transition et tremblantes
         */
        FFH7140,
        /** Roselières (Phragmition, Phalaridion, Sparganio-Glycerion)
         */
        BK06,
        /** Magnocariçaie (Magnocaricion)
         */
        BK04,
        /** Lacs eutrophes naturels avec végétation du Magnopotamion ou Hydrocharition
         */
        FFH3150,
        /** Eaux oligo-mésotrophes calcaires avec végétation benthique à Chara spp. (Characeae)
         */
        FFH3140,
        /** Eaux stagnantes, oligotrophes à mésotrophes avec végétation du Littorelletea uniflorae et/ou du Isoëto-Nanojuncetea
         */
        FFH3130,
        /** Eaux stagnantes
         */
        BK08,
        /** "Gebüsch sonstiger Standorte"
         */
        Gb,
        /** "Gebüsch nasser Standorte"
         */
        Gbf,
        /** eaux courantes
         */
        EC,
        /** marais des sources
         */
        BK11,
        /** Grottes non exploitées par le tourisme
         */
        FFH8310,
        /** Prairies à Molinia
         */
        FFH6410,
        /** Éboulis médio-européens calcaires des étages collinéen à montagnard
         */
        FFH8160,
        /** Pelouses rupicoles calcaires ou basiphiles (Alysso-Sedion albi)
         */
        FFH6110,
        /** Roches siliceuses avec végétation pionnière (Sedo-Scleranthion, Sedo albi-Veronicion dillenii)
         */
        FFH8230,
        /** Pelouses maigres sableuses et siliceuses
         */
        BK07,
        /** Prairies humides du Calthion
         */
        BK10,
        /** Prairies maigres de fauche de basse altitude
         */
        FFH6510,
        /** Pelouses sèches semi-naturelles sur calcaires (Festuco-Brometalia)
         */
        FFH6210,
        /** Formations à Juniperus (Juniperus communis)
         */
        FFH5130,
        /** Landes sèches à callune
         */
        FFH4030,
        /** Formations herbeuses à Nardus
         */
        FFH6230,
        /** Mégaphorbiaies hygrophiles des cours d'eau et lisières forestières
         */
        FFH6430,
        /** "Eischen-Hainbuchenwald trocken-warmer Standorte"
         */
        EHWtS,
        /** Vergers
         */
        BK09,
        /** "Eischen-Hainbuchenwald mittlerer Standorte"
         */
        EHWms,
        /** "Perlgras-Buchenwald"
         */
        PBuW,
        /** "Hainsimsen-Buchenwald"
         */
        HBuW,
        /** "Schluchtwald"
         */
        SchW,
        /** "Auenwaldstreifen"
         */
        AuWS,
        /** "Auenwald"
         */
        AuW,
        /** "Bruchwald"
         */
        BruW,
        /** "Sukzessionswald (überwiegend) aus Laubbäumen"
         */
        Sukzl,
        /** "Aufforstung mit standorttypischen Laubbäumen"
         */
        Auf,
        /** Éboulis médio-européens siliceux
         */
        FFH8150,
        /** Pentes rocheuses calcaires avec végétation chasmophytique
         */
        FFH8210,
        /** Pentes rocheuses siliceuses avec végétation chasmophytique
         */
        FFH8220,
        /** haie-"Feldhecke"
         */
        FHe,
        /** haie-"Schnitthecke"
         */
        SHe,
        /** "Waldmantel"
         */
        Wma,
        /** groupes arbres
         */
        BG
      );
      /** géometrie du biotope
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END BIOTOPE_POLY;

  END ARTIKEL17;

  /** Contient des informations à titre indicatif
   */
  TOPIC INFORMATIONS_SUPPLEMENTAIRES =

    /** Contient des informations à titre indicatif (lignes)
     */
    CLASS INFO_SUPP_LIGNE =
      CODE : TEXT*20;
      /** Nom du fichier word contenant la partie écrite de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (ligne)
       */
      GEOMETRIE : MANDATORY POLYLINE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END INFO_SUPP_LIGNE;

    /** Contient des informations à titre indicatif (points)
     */
    CLASS INFO_SUPP_POINT =
      CODE : TEXT*20;
      /** Nom du fichier word contenant la partie écrite de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (point)
       */
      GEOMETRIE : MANDATORY PAG.LUREF;
    END INFO_SUPP_POINT;

    /** Contient des informations à titre indicatif (surface)
     */
    CLASS INFO_SUPP_POLY =
      CODE : TEXT*20;
      /** Nom du fichier word contenant la partie écrite de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (surface)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END INFO_SUPP_POLY;

  END INFORMATIONS_SUPPLEMENTAIRES;

  /** Contient les éléments relevant pour la création du PAG
   */
  TOPIC PAG =

    /** Alignement à respecter (ligne)
     */
    CLASS ALIGN_A_RESP =
      /** Texte explicatif
       */
      CATEGORIE : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (ligne)
       */
      GEOMETRIE : MANDATORY POLYLINE WITH (STRAIGHTS) VERTEX PAG.LUREF;
    END ALIGN_A_RESP;

    /** Inventaire de tous les bâtiments de la commune
     */
    CLASS BATIMENT =
      /** Géométrie (surface)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END BATIMENT;

    /** Constructions à conserver (ligne)
     */
    CLASS CONST_A_CONS_LIGNE =
      /** Texte explicatif
       */
      CATEGORIE : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (ligne)
       */
      GEOMETRIE : MANDATORY POLYLINE WITH (STRAIGHTS) VERTEX PAG.LUREF;
    END CONST_A_CONS_LIGNE;

    /** Constructions à conserver (point)
     */
    CLASS CONST_A_CONS_POINT =
      /** Texte explicatif
       */
      CATEGORIE : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (point)
       */
      GEOMETRIE : MANDATORY PAG.LUREF;
    END CONST_A_CONS_POINT;

    /** Constructions à conserver (surface)
     */
    CLASS CONST_A_CONS_POLY =
      /** Texte explicatif
       */
      CATEGORIE : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (surface)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END CONST_A_CONS_POLY;

    /** Art. 31 Zones de servitude « couloirs et espaces réservés » selon RGD du 02 mars 2026
     */
    CLASS COULOIRS_ET_ESP_RES =
      /** Type de couloir
       */
      CODE (FINAL) : MANDATORY (
        /** couloirs pour projets routiers
         */
        CPR,
        /** couloirs pour projets ferroviaires
         */
        CPF,
        /** couloirs pour projets de mobilité douce
         */
        CPMD,
        /** couloirs pour projets de canalisation pour eaux usées
         */
        CP_EU,
        /** couloirs pour projets de rétention et d'écoulement des eaux pluviales
         */
        CP_R_EP
      );
      /** Subdivision de la zone définie dans catégorie
       */
      GENRE : TEXT*10;
      /** Largeur du couloir en mètre
       */
      LARGEUR : MANDATORY 0.00 .. 100.00;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie du couloir
       */
      GEOMETRIE : MANDATORY POLYLINE WITH (STRAIGHTS) VERTEX PAG.LUREF;
    END COULOIRS_ET_ESP_RES;

    /** Art. 31 Zones de servitude « couloirs et espaces réservés » selon RGD du 02 mars 2026 avec une largeur variable
     */
    CLASS COULOIRS_ET_ESP_RES_PG =
      /** Type de couloir
       */
      CODE (FINAL) : MANDATORY (
        /** couloirs pour projets de canalisation pour eaux usées
         */
        CP_EU,
        /** couloirs pour projets de rétention et d'écoulement des eaux pluviales
         */
        CP_R_EP,
        /** couloirs pour projets routiers
         */
        CPR,
        /** couloirs pour projets ferroviaires
         */
        CPF,
        /** couloirs pour projets de mobilité douce
         */
        CPMD
      );
      /** Subdivision de la zone définie dans catégorie
       */
      GENRE : TEXT*10;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie du couloir
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END COULOIRS_ET_ESP_RES_PG;

    /** Zone d'emplacement de stationnement
     */
    CLASS EMPLAC_STAT =
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie de la zone
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END EMPLAC_STAT;

    /** PCN ou fond de plan qui servait comme base à l'élaboration du PAG
     */
    CLASS FOND_DE_PLAN =
      /** NUM_CADASTRAL/CODE_SUP
       */
      NUM_CADAST : MANDATORY TEXT*20;
      /** Géométrie
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END FOND_DE_PLAN;

    /** Gabarit à sauvegarder (point)
     */
    CLASS GABARIT_A_SAUV_POINT =
      /** Texte explicatif
       */
      CATEGORIE : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (point)
       */
      GEOMETRIE : MANDATORY PAG.LUREF;
    END GABARIT_A_SAUV_POINT;

    /** Gabarit à sauvegarder (surface)
     */
    CLASS GABARIT_A_SAUV_POLY =
      /** Texte explicatif
       */
      CATEGORIE : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (surface)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END GABARIT_A_SAUV_POLY;

    /** Géométrie (surface) de la limte communale selon base cadastrale du PAG
     */
    CLASS LIMITES_COMMUNALES =
      /** Géométrie (polygone)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END LIMITES_COMMUNALES;

    /** Limites de la modification ponctuelle du PAG
     */
    CLASS MODIFICATION_PAG =
      /** Date de la modification
       */
      DATE_MODIF : MANDATORY FORMAT INTERLIS.XMLDate "2011-1-1" .. "2030-1-1";
      /** Limites de la modification PAG
       */
      GEOMETRIE : SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END MODIFICATION_PAG;

    /** Art. 37 Zone soumise à un plan d'aménagement particulier « nouveau quartier » selon RGD du 02 mars 2026
     */
    CLASS NQ_PAP =
      /** Valeur du coefficient d'occupation du sol minimum (COS MIN)
       */
      COS_MIN : 0.00 .. 1.00;
      /** Valeur du coefficient d'occupation du sol maximum (COS MAX)
       */
      COS_MAX : 0.00 .. 1.00;
      /** Valeur du coefficient d'utilisation du sol minimum (CUS MIN)
       */
      CUS_MIN : 0.00 .. 10.00;
      /** Valeur du coefficient d'utilisation du sol maximum (CUS MAX)
       */
      CUS_MAX : 0.00 .. 10.00;
      /** Coefficient de scellement du sol (CSS)
       */
      CSS_MAX : 0.00 .. 1.00;
      /** Densité de logement minimum (DL MIN)
       */
      DL_MIN : 0.00 .. 1000.00;
      /** Densité de logement maximum (DL MAX)
       */
      DL_MAX : 0.00 .. 1000.00;
      /** Dénomination de la zone
       */
      DENOMINATION : TEXT*100;
      /** Nom du fichier pdf du schéma directeur
       */
      NOM_FICHIER_SD_EC : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER_EC : MANDATORY TEXT*100;
      /** Nom du fichier pdf contenant la partie graphique du schéma directeur
       */
      NOM_FICHIER_SD_GR : TEXT*100;
      /** Genre de la zone superposée nouveau quartier
       */
      GENRE (FINAL) : MANDATORY (
        /** Zone nouveau quartier selon la loi modifiée du 19 juillet 2004
         */
        neant,
        /** Zone nouveau quartier Art.29bis paragraphe 2 alinéa 3 selon la loi modifiée du 19 juillet 2004
         */
        Art29bis2al3
      );
      /** Géométrie du quartier
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END NQ_PAP;

    /** PAP approuvés
     */
    CLASS PAP_APPROUVE =
      /** Nom du fichier pdf contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER_EC : TEXT*100;
      /** Nom du fichier pdf contenant la partie graphique du PAG de l'article concerné
       */
      NOM_FICHIER_GR : MANDATORY TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : TEXT*100;
      /** Géométrie du PAP approuvé
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END PAP_APPROUVE;

    /** Délimitation du périmètre
     */
    CLASS PERIMETRE =
      /** Géométrie (surface)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END PERIMETRE;

    /** Art. 28 Zone d'aménagement différé selon RGD du 02 mars 2026
     */
    CLASS ZAD =
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie du quartier
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END ZAD;

    /** Zonage: Le mode d’utilisation des zones urbanisées ou destinées à être urbanisées (Art. 8-23 du RGD du 02 mars 2026) et catégories de la zone verte (Art. 27 du RGD du 02 mars 2026)
     */
    CLASS ZONAGE =
      /** Categorie de la zone (voire liste)
       */
      CATEGORIE (FINAL) : MANDATORY (
        /** Art. 8 Zones d'habitation 1 selon RGD du 02 mars 2026
         */
        HAB_1,
        /** Art. 8 Zones d'habitation 2 selon RGD du 02 mars 2026
         */
        HAB_2,
        /** Art. 9 Zones mixtes urbaines centrale selon RGD du 02 mars 2026
         */
        MIX_c,
        /** Art. 9 Zones mixtes urbaines selon RGD du 02 mars 2026
         */
        MIX_u,
        /** Art. 9 Zones mixtes villageoises selon RGD du 02 mars 2026
         */
        MIX_v,
        /** Art. 9 Zones mixtes rurales selon RGD du 02 mars 2026
         */
        MIX_r,
        /** Art. 10 Zones de bâtiments et d'équipements publics selon RGD du 02 mars 2026
         */
        BEP,
        /** Art. 11 Zones d'activités économiques communales selon RGD du 02 mars 2026
         */
        ECO_c,
        /** Zones d'activités économiques communales type 1 selon Art. 11 du RGD du 08 mars 2017
         */
        ECO_c1,
        /** Zones d'activités économiques communales type 1 selon Art. 12 du RGD du 08 mars 2017
         */
        ECO_c2,
        /** Zones d'activités économiques communales type 3
         */
        ECO_c3,
        /** Art. 13 Zones d'activités économiques régionales selon RGD du 02 mars 2026
         */
        ECO_r,
        /** Zones d'activités économiques régionales type 1 selon Art. 14 du RGD du 28 juillet 2011
         */
        ECO_r1,
        /** Zones d'activités économiques régionales type 2 selon Art. 14 du RGD du 28 juillet 2011
         */
        ECO_r2,
        /** Art. 14 Zones d'activités économiques nationales selon RGD du 02 mars 2026
         */
        ECO_n,
        /** Art. 15 Zones d'activités spécifiques nationales selon RGD du 02 mars 2026
         */
        SP_n,
        /** Art. 16 Zones commerciales selon RGD du 02 mars 2026
         */
        COM,
        /** Art. 17 Zones militaires selon RGD du 02 mars 2026
         */
        MIL,
        /** Art. 18 Zones d'aérodrome selon RGD du 02 mars 2026
         */
        AERO,
        /** Art. 19 Zones portuaires
         * port de marchandises selon RGD du 02 mars 2026
         */
        PORT_m,
        /** Art. 19 Zones portuaires
         * port de plaisance selon RGD du 02 mars 2026
         */
        PORT_p,
        /** Art. 20 Zones de gares ferroviaires et routières selon RGD du 02 mars 2026
         */
        GARE,
        /** Art. 21 Zones de sports et de loisirs selon RGD du 02 mars 2026
         */
        REC,
        /** Art. 22 Zones spéciales selon RGD du 02 mars 2026
         */
        SPEC,
        /** Art. 23 Zones de jardins familiaux selon RGD du 02 mars 2026
         */
        JAR,
        /** Art. 23bis Zones de parc urbain selon RGD du 02 mars 2026
         */
        ZPU,
        /** Art. 27 Zones agricoles selon RGD du 02 mars 2026
         */
        AGR,
        /** Art. 27 Zones forestières selon RGD du 02 mars 2026
         */
        FOR,
        /** Art. 27 Zones viticoles selon RGD du 02 mars 2026
         */
        VIT,
        /** Art. 27 Zones horticoles selon RGD du 02 mars 2026
         */
        HOR,
        /** Art. 27 Zones de verdure selon RGD du 02 mars 2026
         */
        VERD,
        /** Art. 27 Zones de parc public selon RGD du 02 mars 2026
         */
        PARC
      );
      /** Subdivision de la zone définie dans la rubrique "catégorie"
       */
      GENRE : TEXT*10;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (surface)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END ZONAGE;

    /** Art. 30 Zones de servitude « urbanisation » selon RGD du 02 mars 2026
     */
    CLASS ZONE_SERV_URB =
      /** Type de la servitude
       */
      CODE : MANDATORY TEXT*20;
      /** Libellé du code
       */
      LIB : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concerné
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie (surface)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END ZONE_SERV_URB;

    /** Informations sur les quartiers existants
     */
    CLASS ZONES_QE =
      /** Nom du fichier word contenant la partie écrite générale du quartier existant
       */
      NOM_FICHIER_EC_GEN : TEXT*100;
      /** Nom du fichier word contenant la partie écrite du quartier existant
       */
      NOM_FICHIER_EC : MANDATORY TEXT*100;
      /** Nom du fichier PDF contenant la partie graphique du quartier existant
       */
      NOM_FICHIER_GR : TEXT*100;
      /** Géométrie (surface)
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END ZONES_QE;

    /** Informations concernant les zones définies dans le règlement grand-ducal du 02 mars 2026 art. 29 et art. 32-36
     */
    CLASS ZONES_SUPERPOSEES =
      /** Type de zone
       */
      CATEGORIE (FINAL) : MANDATORY (
        /** Art. 32 Secteur protégé d'intérêt communal de type « vestiges archéologiques » selon RGD du 02 mars 2026
         */
        SPI_A,
        /** Art. 32 Secteur protégé d'intérêt communal de type « environnement construit » selon RGD du 02 mars 2026
         */
        SPI_EC,
        /** Art. 32 Secteur protégé d'intérêt communal de type « environnement naturel et paysage » selon RGD du 02 mars 2026
         */
        SPI_ENP,
        /** Art. 33 Zones de risques naturels prévisibles « zones de risque d'éboulement ou de glissements de terrain » selon RGD du 02 mars 2026
         */
        ZRNP_G,
        /** Art. 33 Zones de risques naturels prévisibles « zones de risques d'éboulement miniers » selon RGD du 02 mars 2026
         */
        ZRNP_M,
        /** Art. 33 Zones de risques naturels prévisibles « zones inondables » selon RGD du 02 mars 2026
         */
        ZRNP_I,
        /** Art. 34 Zones à risques concernant la prévention des accidents majeurs impliquant des substances dangereuses selon RGD du 02 mars 2026
         */
        ZR_SD,
        /** Art. 35 Zones de bruit selon RGD du 02 mars 2026
         */
        ZB,
        /** Art. 36 Zones d'extraction selon RGD du 02 mars 2026
         */
        ZE,
        /** Art. 29 Zones urbanisation prioritaire selon RGD du 02 mars 2026
         */
        ZUP
      );
      /** Subdivision de la zone définie dans la rubrique "catégorie"
       */
      GENRE : TEXT*10;
      /** Nom du fichier word contenant la partie écrite du PAG de l'article concernée
       */
      NOM_FICHIER : MANDATORY TEXT*100;
      /** Géométrie de la zone
       */
      GEOMETRIE : MANDATORY SURFACE WITH (STRAIGHTS) VERTEX PAG.LUREF WITHOUT OVERLAPS>0.01;
    END ZONES_SUPERPOSEES;

  END PAG;

END PAG.
